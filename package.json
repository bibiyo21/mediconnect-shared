    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "turbo": "2.11.12",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
