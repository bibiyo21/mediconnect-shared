{
  "name": "mediconnect-shared",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "generate": "node scripts/generate-api.mjs",
    "check:generated": "node scripts/generate-api.mjs && git diff --exit-code -- packages/api-client/src/generated",
