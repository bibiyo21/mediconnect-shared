{
  "name": "@mediconnect/api-client",
  "version": "0.1.0",
  "description": "Typed MediConnect API client generated from the backend OpenAPI contract",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@mediconnect/configuration": "workspace:*",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bibiyo21/mediconnect-shared.git",
    "directory": "packages/api-client"
  }
}
