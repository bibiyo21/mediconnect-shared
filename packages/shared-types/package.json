{
  "name": "@mediconnect/shared-types",
  "version": "0.1.0",
  "description": "MediConnect domain types derived from the OpenAPI contract",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@mediconnect/configuration": "workspace:*"
  },
  "dependencies": {
    "@mediconnect/api-client": "workspace:*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bibiyo21/mediconnect-shared.git",
    "directory": "packages/shared-types"
  }
}
